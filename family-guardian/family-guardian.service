[Unit]
Description=family-guardian (AI safety demo) — fall + breathing monitor
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/family-guardian
ExecStart=/home/YOUR_USER/family-guardian/run_forever.sh
Restart=always
RestartSec=5
StandardOutput=append:/home/YOUR_USER/family-guardian/logs/runner.log
StandardError=append:/home/YOUR_USER/family-guardian/logs/runner.log

[Install]
WantedBy=multi-user.target
